OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text
# Raise for long-chunk bulk embeds (Wikipedia pages); default 120
OLLAMA_REQUEST_TIMEOUT_SEC=120
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documind_papers
CHROMA_COLLECTION_PUBLIC=documind_wikipedia
# public | papers — default query/ingest target
DEFAULT_LIBRARY=public
# true = legacy: index bundled data/sample_docs into papers on startup (discouraged for Wikipedia-first)
SEED_SAMPLE_DOCS=false
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=6
RELEVANCE_THRESHOLD=0.45
# Public Wikipedia-scale index (library=public): retrieval tuning
PUBLIC_RELEVANCE_THRESHOLD=0.52
PUBLIC_KEYWORD_RERANK_WEIGHT=0.22
MAX_FILE_SIZE_MB=50
ARXIV_BASE_URL=https://export.arxiv.org/pdf
SAMPLE_CORPUS_VERSION=7
ENABLE_FALLBACK_RETRIEVAL=true
FALLBACK_TOP_N=3
KEYWORD_RERANK_WEIGHT=0.15
# Comma-separated browser origins allowed to call the API (Next.js dev server, etc.)
CORS_ORIGINS=http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:3000,http://localhost:3000
# Set true only for quick open demos — not for shared or production hosts
CORS_ALLOW_ALL=false
APP_ENV=development
LOG_LEVEL=INFO
# TRUSTED_HOSTS=api.example.com,localhost
TRUSTED_HOSTS=
DISABLE_OPENAPI=false
API_KEY=
# Optional build id for GET /api/v1/diagnostics (dashboard shows when set)
# DOCMIND_GIT_SHA=
LOG_JSON=false
ENABLE_RESPONSE_GZIP=true
# FLARE-inspired active retrieval (optional second embedding search). See README.
FLARE_ACTIVE_RETRIEVAL=false
FLARE_DRAFT_MAX_CONTEXT_CHARS=3200

# --- Large public corpus (optional tuning) ---
# Fewer, larger chunks => fewer embed calls, blurrier retrieval:
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=120
# Wider pool before distance filter:
# TOP_K_RESULTS=8
# RELEVANCE_THRESHOLD=0.52
# bulk_index_public: --workers 6-12 if Ollama keeps up; --progress-every 100 to thin logs
